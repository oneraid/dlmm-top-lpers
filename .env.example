# --- Database / Queue ---
DATABASE_URL=postgresql://dlmm:dlmm@localhost:5432/dlmm_top_lpers
REDIS_URL=redis://localhost:6379

# --- Solana RPC: PUBLIC ONLY (user decision, 2026-11-16). No API keys. ---
RPC_PUBLIC_ENDPOINTS=https://api.mainnet-beta.solana.com
RPC_GPA_MIN_INTERVAL_MS=3000
RPC_GPA_CONCURRENCY=1
RPC_LIGHT_MAX_RPS=5

# --- Free data APIs (no key) ---
METEORA_API_BASE=https://dlmm.datapi.meteora.ag
JUPITER_PRICE_BASE=https://lite-api.jup.ag/price/v3

# --- Pipeline defaults (also editable via UI Settings -> scoring_config) ---
SCAN_TOP_POOLS=50
SCAN_INTERVAL_HOURS=12
PROFILER_DAILY_TARGET=1000
USER_CAPITAL_SOL=10

# --- Copy-trade bot integration (optional) ---
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
